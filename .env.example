# All optional. With none of these set, research runs on free sources and the writing runs inside Claude Code.
# Copy to .env and fill only what you use. Never commit .env.

ANTHROPIC_API_KEY=        # write.py API mode (otherwise use Claude Code, see README)
FIRECRAWL_API_KEY=        # retry a website page the free fetch could not read
APIFY_TOKEN=              # pull a person's recent LinkedIn posts (opt-in, see README on terms of service)
